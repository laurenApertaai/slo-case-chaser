# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption key for bank details (32 bytes, base64).
#
# LOSING THIS LOSES THE DATA. There is no reset. A copy is escrowed outside
# this machine, and `npm run check-key` proves the one here matches it.
BANK_DETAILS_KEY=

# Retired keys, comma separated. Anything sealed under one of these still
# opens, so the key above can be replaced without stranding what is stored.
BANK_DETAILS_KEY_PREVIOUS=

# Shared secret required by the /api/cron/* endpoints
CRON_SECRET=

# Added in phase 6 — not needed yet
RESEND_API_KEY=
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=

# Supabase publishable key - safe to be public, used by the login page
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
